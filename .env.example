PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# Optional — improves BrAPI rate limits for educational tickers
BRAPI_TOKEN=

# Belvo Open Finance (Sandbox by default). Never expose these to the frontend.
BELVO_ENV=sandbox
BELVO_BASE_URL=https://sandbox.belvo.com
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_WEBHOOK_SECRET=
BELVO_WIDGET_CALLBACK_BASE_URL=http://localhost:5173
BELVO_TERMS_URL=https://belvo.com/terms-service/
# SVG HTTPS (quadrado). Hosted Widget / SDK rejeitam http://localhost.
BELVO_COMPANY_ICON_URL=https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/1f3e6.svg
BELVO_COMPANY_LOGO_URL=https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/1f3e6.svg
OPEN_FINANCE_DEMO_ENABLED=true
BELVO_COMPANY_NAME=Valora
